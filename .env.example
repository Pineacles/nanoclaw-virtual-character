# NanoClaw environment configuration
# Copy this file to .env and fill in real values. Never commit .env.

# Claude Agent SDK auth — OAuth token from `claude setup-token` (preferred over an API key)
CLAUDE_CODE_OAUTH_TOKEN=

# Shared secret required to access the web UI / web channel
WEB_AUTH_TOKEN=

# Port the web UI / web channel HTTP server listens on
WEB_PORT=

# Port the local credential proxy listens on (injects secrets into containers)
CREDENTIAL_PROXY_PORT=

# Display name the assistant uses for itself (persona identity)
ASSISTANT_NAME=

# Set to "true" if this assistant has its own dedicated phone number (affects group/DM routing)
ASSISTANT_HAS_OWN_NUMBER=

# Which groups/ subfolder this instance serves in a multi-instance deployment
NANOCLAW_WEB_GROUP=

# Override the default store/ directory (per-user data, session state)
NANOCLAW_STORE_DIR=

# Override the default data/ directory (persistent app data)
NANOCLAW_DATA_DIR=

# Path to this instance's own .env file, so multi-instance deployments don't
# bleed values across personas via a shared ./.env (see src/env.ts)
NANOCLAW_ENV_FILE=

# Comma-separated list of phone numbers (E.164, no "+") allowed to message this instance
WHATSAPP_ALLOWED_NUMBERS=

# Timezone used for scheduling and timestamps, e.g. America/New_York
TZ=
